+                                  (unsigned long long)(g_skips[i] - g_a51_skips[i]));
+        }
+        g_a51_skips[i] = g_skips[i];
+    }
+    if (!g_a51_rows && !g_a51_draws) {
+        return;
+    }
+    char rt[64], fr[64];
+    a51_obj(rt, sizeof(rt), g_pd.rt);
+    a51_obj(fr, sizeof(fr), g_pd.frame_rt);
+    a51_out("swap %llu: %llu draws in %u kinds (%u not listed), bound %s, frame target %s, display "
+            "%ux%u moded %d, skipped:%s",
+            (unsigned long long)g_pd.swaps + 1, (unsigned long long)g_a51_draws, g_a51_rows, g_a51_lost, rt, fr,
+            g_pd.disp_w, g_pd.disp_h, (int)g_disp_moded, sk[0] ? sk : " none");
+    for (unsigned i = 0; i < g_a51_rows; i++) {
+        a51_out("  x%-4u #%u-%u v%-6llu [%s] [%s] %s", g_a51_row[i].n, g_a51_row[i].first, g_a51_row[i].last,
+                (unsigned long long)g_a51_row[i].verts, g_a51_row[i].v0, g_a51_row[i].vn, g_a51_row[i].key);
+    }
+    g_a51_caps++;
+    g_a51_rows = g_a51_lost = 0;
+    g_a51_draws = 0;
+}
