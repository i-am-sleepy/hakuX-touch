+/* The app's log folder, <files>/logs/current: Settings -> Export logs zips
+ * every file in it. HAKUX_NATIVE_BASE is <files>/native/hdd/../hle
+ * (native/app/app_main.c), the files folder three components up from the hard
+ * disk's. NULL where there is none. */
+const char *hle_app_logdir(void)
+{
+    static char dir[512];
+    static bool done;
+    static pthread_mutex_t mu = PTHREAD_MUTEX_INITIALIZER;
+    pthread_mutex_lock(&mu);
+    if (!done) {
+        done = true;
+        const char *base = getenv("HAKUX_NATIVE_BASE");
+        char tmp[512];
+        if (base && snprintf(tmp, sizeof(tmp), "%s", base) < (int)sizeof(tmp)) {
+            const size_t n = strlen(tmp), t = strlen("/../hle");
+            if (n > t && !strcmp(tmp + n - t, "/../hle")) {
+                tmp[n - t] = 0;                     /* <files>/native/hdd */
+            } else if (strrchr(tmp, '/')) {
+                *strrchr(tmp, '/') = 0;
+            }
+            for (unsigned i = 0; i < 2; i++) {      /* hdd, native */
+                char *sl = strrchr(tmp, '/');
+                if (sl) {
+                    *sl = 0;
+                }
+            }
+            if (snprintf(dir, sizeof(dir), "%s/logs/current", tmp) >= (int)sizeof(dir)) {
+                dir[0] = 0;
+            }
+        }
+    }
+    pthread_mutex_unlock(&mu);
+    return dir[0] ? dir : NULL;
+}
+
+#define HLE_LOG_FILE_MAX (12u << 20)
+
+/* Every line also goes to hle.log in the app's log folder: logcat capture can
+ * stop early on a device and the export then lacks the lines that matter
+ * (a shader that failed to build, a draw dropped); a file can't. The same line
+ * again is counted, not written; a lock held (a line from a signal handler,
+ * say) drops the line rather than waits; the file stops at 12 MB. Area 51's
+ * census has a file of its own (pb/pbdraw.c). */
+static void hle_log_file(const char *tag, const char *msg)
+{
+    static pthread_mutex_t mu = PTHREAD_MUTEX_INITIALIZER;
+    static FILE *fp;
+    static bool tried;
+    static size_t bytes;
+    static char last[1100];
+    static unsigned rep;
+    static struct timespec t0;
+    if (!strcmp(tag, "hakuX-a51") || pthread_mutex_trylock(&mu)) {
+        return;
+    }
+    if (!tried) {
+        tried = true;
+        const char *dir = hle_app_logdir();
+        if (dir) {
+            char path[600];
+            snprintf(path, sizeof(path), "%s/hle.log", dir);
+            fp = fopen(path, "a");
+        }
+        clock_gettime(CLOCK_MONOTONIC, &t0);
+    }
+    if (fp && bytes < HLE_LOG_FILE_MAX) {
+        char line[1100];
+        snprintf(line, sizeof(line), "%s: %s", tag, msg);
+        if (!strcmp(line, last)) {
+            rep++;
+        } else {
+            struct timespec t;
+            clock_gettime(CLOCK_MONOTONIC, &t);
+            int n = 0;
+            if (rep) {
+                n += fprintf(fp, "  (the last line again %u times)\n", rep);
+                rep = 0;
+            }
+            n += fprintf(fp, "%9.3f %s\n", (double)(t.tv_sec - t0.tv_sec) + (double)(t.tv_nsec - t0.tv_nsec) / 1e9,
+                         line);
+            if (n > 0) {
+                bytes += (size_t)n;
+            }
+            snprintf(last, sizeof(last), "%s", line);
+            if (bytes >= HLE_LOG_FILE_MAX) {
+                fputs("(hle.log is full)\n", fp);
+            }
+            fflush(fp);
+        }
+    }
+    pthread_mutex_unlock(&mu);
+}
+
 void hle_log(const char *tag, const char *fmt, ...)
 {
     char buf[1024];
@@ -31,6 +128,7 @@
 #else
     fprintf(stderr, "%s: %s\n", tag, buf);
 #endif
+    hle_log_file(tag, buf);
 }
 
