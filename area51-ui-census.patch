+        return;
+    }
+    static bool armed;
+    if (!armed) {
+        armed = true;
+        a51_out("frame census armed (title %08x): one frame in %u from swap %u, up to %u of them",
+                g_hle.title.xbe.title_id, A51_EVERY, A51_PHASE, A51_CAPS);
+    }
+    a51_decide();
+    g_a51_f_draws = g_a51_f_small = g_a51_ntex = 0;
+    if (g_a51_last_req && g_a51_clean_at < g_a51_last_req && g_pd.swaps + 1 - g_a51_last_req >= 90) {
+        g_a51_clean_at = g_pd.swaps + 1;
+        a51_clean();
+    }
+    char sk[256] = "";
