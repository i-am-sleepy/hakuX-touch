+  /**
+   * Where bytes occur in default.xbe's sections as the disc has them: find, with
+   * mask 0 for a byte of any value (else 0xFF). The virtual address of each
+   * match and the bytes there; limit + 1 matches at most, so more than limit
+   * means too many. A match doesn't overlap the one before it in its section.
+   */
+  fun findInXbe(find: ByteArray, mask: ByteArray, limit: Int): List<Pair<Long, ByteArray>> {
+    val x = xbe ?: return emptyList()
+    val n = find.size
+    if (n == 0 || mask.size != n) return emptyList()
+    val h = x.headers
+    val count = h.getInt(0x11C)
+    if (count !in 1..1024) return emptyList()
+    val table = headerOffset(x, h.getInt(0x120), count * 0x38) ?: return emptyList()
+    val out = ArrayList<Pair<Long, ByteArray>>()
+    for (i in 0 until count) {
+      val s = table + i * 0x38
+      val va = h.getInt(s + 0x04).toLong() and MASK
+      val raw = h.getInt(s + 0x0C).toLong() and MASK
+      val size = h.getInt(s + 0x10).toLong() and MASK
+      var pos = 0L
+      while (pos + n <= size) {
+        val len = minOf(SCAN_CHUNK, size - pos).toInt()
+        val buf = readAt(ch, x.start + raw + pos, len) ?: break
+        val data = buf.array()
+        var j = 0
+        while (j + n <= len) {
+          if (matchesAt(data, j, find, mask)) {
+            out.add((va + pos + j) to data.copyOfRange(j, j + n))
+            if (out.size > limit) return out
+            j += n
+          } else {
+            j++
+          }
+        }
+        if (pos + len >= size) break
+        pos += (len - (n - 1)).toLong()
+      }
+    }
+    return out
+  }
+
+  private fun matchesAt(data: ByteArray, at: Int, find: ByteArray, mask: ByteArray): Boolean {
+    for (k in find.indices) {
+      val m = mask[k].toInt() and 0xFF
+      if ((data[at + k].toInt() and 0xFF and m) != (find[k].toInt() and 0xFF)) return false
+    }
+    return true
+  }
