+package com.rfandango.haku_x.data
+
+/**
+ * A "find <bytes> -> <bytes>" line of a mod (mods/README.md): the bytes to look
+ * for in the XBE and what to write over them, as widescreen patch lists give
+ * them ("initial value", "change to"). "??" is a byte of any value; in the
+ * replacement it keeps the byte found. The core only knows patches at an
+ * address, so ModRun turns each match into one.
+ */
+class FindPatch(
+  val find: ByteArray,
+  val findMask: ByteArray,
+  private val repl: ByteArray,
+  private val replMask: ByteArray,
+) {
+  /** What is written where `found` matched: the replacement, a wildcard keeping the byte there. */
+  fun replacement(found: ByteArray): ByteArray =
+    ByteArray(repl.size) { if (replMask[it].toInt() == 0) found[it] else repl[it] }
+
+  companion object {
+    private const val MAX_BYTES = 256
+
+    /** The patch a line says, or null when it isn't a find line, or its two byte lists differ in length. */
+    fun parse(line: String): FindPatch? {
+      val t = line.trim()
+      if (!t.startsWith("find", ignoreCase = true)) return null
+      var rest = t.substring(4)
+      if (rest.isNotEmpty() && rest[0] != ':' && !rest[0].isWhitespace()) return null
+      if (rest.startsWith(":")) rest = rest.substring(1)
+      val parts = rest.substringBefore('#').split("->")
+      if (parts.size != 2) return null
+      val a = bytes(parts[0]) ?: return null
+      val b = bytes(parts[1]) ?: return null
+      if (a.first.size != b.first.size) return null
+      return FindPatch(a.first, a.second, b.first, b.second)
+    }
+
+    private fun isHex(c: Char) = c in '0'..'9' || c in 'a'..'f' || c in 'A'..'F'
+
+    /** Hex pairs (spaces anywhere) and "??": the bytes and their masks (0xFF: must match, 0: any). */
+    private fun bytes(text: String): Pair<ByteArray, ByteArray>? {
+      val s = text.filter { !it.isWhitespace() }
+      if (s.isEmpty() || s.length % 2 != 0 || s.length / 2 > MAX_BYTES) return null
+      val value = ByteArray(s.length / 2)
+      val mask = ByteArray(s.length / 2)
+      for (i in value.indices) {
+        val hi = s[i * 2]
+        val lo = s[i * 2 + 1]
+        if (hi == '?' && lo == '?') continue
+        if (!isHex(hi) || !isHex(lo)) return null
+        value[i] = ((Character.digit(hi, 16) shl 4) or Character.digit(lo, 16)).toByte()
+        mask[i] = 0xFF.toByte()
+      }
+      return value to mask
+    }
+
+    /** Bytes as the patch lines write them: "DB 44 24 68". */
+    fun hex(bytes: ByteArray): String = bytes.joinToString(" ") { "%02X".format(it.toInt() and 0xFF) }
+  }
+}
