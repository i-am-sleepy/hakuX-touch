+    assertEquals(listOf("A"), TouchLookConfig.parseTargets("A,A,nonsense,"))
+    assertEquals(emptyList<String>(), TouchLookConfig.parseTargets(""))
+    assertEquals("X", TouchLookConfig.formatTargets(listOf("", "X")))
