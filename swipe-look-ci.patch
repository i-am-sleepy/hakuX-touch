+    showMenuDialog(
+      AlertDialog.Builder(this)
+        .setTitle(title)
+        .setSingleChoiceItems(values.map(label).toTypedArray(), values.indexOf(current)) { dialog, which ->
+          setTouchLook(key, apply(values[which]))
+          then()
+          dialog.dismiss()
+        }
+        .setNegativeButton(android.R.string.cancel) { _, _ -> then() }
+    )
+  }
