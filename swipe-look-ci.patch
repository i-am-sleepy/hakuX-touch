+package com.rfandango.haku_x.input
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.math.atan2
+import kotlin.math.hypot
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.round
+
+class TouchLookEngineTest {
+  private class Stroke(val startMs: Double, val durationMs: Double, val totalX: Double, val totalY: Double)
+
+  private class Event(val arrival: Double, val time: Double, val dx: Double, val dy: Double, val down: Boolean)
+
+  private class Outcome(
+    /** What a game turning at the stick's rate would have turned the camera by (dp of finger travel). */
+    val movedX: Double,
+    val peak: Double,
+    val lastNonZeroMs: Double,
+    val moreAtEnd: Boolean,
+    val minDegrees: Double,
+    val maxDegrees: Double,
+  )
+
+  /** A minimum-jerk reach, the shape of a real finger's flick: 0 at start, total at start + duration. */
+  private fun reach(total: Double, start: Double, duration: Double, t: Double): Double {
+    val s = min(max((t - start) / duration, 0.0), 1.0)
+    return total * (10 * s * s * s - 15 * s * s * s * s + 6 * s * s * s * s * s)
+  }
+
+  /**
+   * Strokes followed by a panel reporting at hz (each report delivered lateMs after it happened),
+   * the stick read every 4 ms until 400 ms after the last finger stopped.
+   */
+  private fun drive(
+    engine: TouchLookEngine,
+    strokes: List<Stroke>,
+    hz: Double = 120.0,
+    window: Double = 24.0,
+    sensitivity: Double = 1.0,
+    deadZone: Double = 0.015,
+    lateMs: Double = 0.5,
+  ): Outcome {
+    val events = ArrayList<Event>()
+    var end = 0.0
+    for (s in strokes) {
+      events += Event(s.startMs + lateMs, s.startMs, 0.0, 0.0, true)
+      var x = 0.0
+      var y = 0.0
+      var k = 1
+      while (true) {
+        val t = s.startMs + k * 1000.0 / hz
+        if (t > s.startMs + s.durationMs) break
+        val nx = reach(s.totalX, s.startMs, s.durationMs, t)
+        val ny = reach(s.totalY, s.startMs, s.durationMs, t)
+        val time = round(t)
+        events += Event(time + lateMs, time, nx - x, ny - y, false)
+        x = nx
+        y = ny
+        k++
+      }
+      end = max(end, s.startMs + s.durationMs)
+    }
+    events.sortBy { it.arrival }
+    var i = 0
+    var moved = 0.0
+    var peak = 0.0
+    var lastNonZero = 0.0
+    var more = false
+    var minDeg = Double.MAX_VALUE
+    var maxDeg = -Double.MAX_VALUE
+    var now = 0.0
+    while (now <= end + 400.0) {
+      while (i < events.size && events[i].arrival <= now) {
+        val e = events[i++]
+        if (e.down) engine.beginStroke(e.time) else engine.addMove(e.time, e.arrival, e.dx, e.dy)
+      }
+      more = engine.sample(now, window, sensitivity, 1.0, deadZone)
+      moved += engine.outX * TouchLookEngine.V_FULL / sensitivity * 0.004
+      val mag = hypot(engine.outX.toDouble(), engine.outY.toDouble())
+      peak = max(peak, mag)
+      if (mag > 0.1) {
+        val deg = Math.toDegrees(atan2(engine.outY.toDouble(), engine.outX.toDouble()))
+        minDeg = min(minDeg, deg)
+        maxDeg = max(maxDeg, deg)
+      }
+      if (mag > 0.0) lastNonZero = now
+      now += 4.0
+    }
+    return Outcome(moved, peak, lastNonZero, more, minDeg, maxDeg)
+  }
+
+  @Test
+  fun anEngineThatSawNothingIsStill() {
+    val e = TouchLookEngine()
+    assertFalse(e.sample(1000.0, 24.0, 1.0, 1.0, 0.2))
+    assertEquals(0f, e.outX, 0f)
+    assertEquals(0f, e.outY, 0f)
+  }
+
+  @Test
+  fun aSteadySwipeReadsAsItsSpeed() {
+    // 600 dp/s: 4.8 dp every 8 ms
+    val e = TouchLookEngine()
+    e.beginStroke(0.0)
+    for (t in 8..1000 step 8) e.addMove(t.toDouble(), t + 0.5, 4.8, 0.0)
+    assertTrue(e.sample(1000.5, 24.0, 1.0, 1.0, 0.015))
+    assertEquals(600.0 / TouchLookEngine.V_FULL, e.outX.toDouble(), 0.002)
+    assertEquals(0.0, e.outY.toDouble(), 1e-6)
+  }
+
+  @Test
+  fun theCameraLandsWhereTheFingerDid() {
+    // a 300 dp flick in 160 ms (sensitivity halved so it doesn't reach full deflection)
+    val r = drive(TouchLookEngine(), listOf(Stroke(100.0, 160.0, 300.0, 0.0)), sensitivity = 0.5)
+    assertEquals(300.0, r.movedX, 3.0)
+    assertTrue(r.peak < 1.0)
+  }
+
+  @Test
+  fun thatHoldsForEveryPanelRateAndSmoothing() {
+    for (hz in listOf(60.0, 120.0, 240.0, 480.0)) {
+      for (w in listOf(8.0, 16.0, 24.0, 40.0)) {
+        val r = drive(TouchLookEngine(), listOf(Stroke(100.0, 200.0, 120.0, 0.0)), hz = hz, window = w)
+        assertEquals("$hz Hz, window $w ms", 120.0, r.movedX, 120.0 * 0.03)
+      }
+    }
+  }
+
+  @Test
+  fun theCameraStopsWithTheFinger() {
+    val r = drive(TouchLookEngine(), listOf(Stroke(100.0, 160.0, 300.0, 0.0)), sensitivity = 0.5)
+    // the finger stops at 260 ms: the stick is zero again within the window and the delay
+    assertTrue("still moving at ${r.lastNonZeroMs} ms", r.lastNonZeroMs - 260.0 < 70.0)
+    assertFalse(r.moreAtEnd)
+  }
+
+  @Test
+  fun aFingerLandingElsewhereIsNoJump() {
+    // the second finger comes down 10 ms after the first lifted (the engine keeps only moves, not places)
+    val one = drive(TouchLookEngine(), listOf(Stroke(100.0, 200.0, 100.0, 0.0)))
+    val two = drive(
+      TouchLookEngine(),
+      listOf(Stroke(100.0, 200.0, 100.0, 0.0), Stroke(310.0, 200.0, 100.0, 0.0)),
+    )
+    assertEquals(200.0, two.movedX, 2.0)
+    assertTrue(two.peak <= one.peak * 1.05)
+  }
+
+  @Test
+  fun aDiagonalSwipeKeepsItsDirection() {
+    val a = Math.toRadians(30.0)
+    val r = drive(
+      TouchLookEngine(),
+      listOf(Stroke(100.0, 300.0, 300.0 * Math.cos(a), 300.0 * Math.sin(a))),
+      deadZone = 0.25,
+    )
+    assertEquals(30.0, r.minDegrees, 0.5)
+    assertEquals(30.0, r.maxDegrees, 0.5)
+  }
+
+  @Test
+  fun sensitivityAndVerticalScaleTheDeflection() {
+    fun steadyY(sensitivity: Double, vertical: Double): Float {
+      val e = TouchLookEngine()
+      e.beginStroke(0.0)
+      for (t in 8..1000 step 8) e.addMove(t.toDouble(), t + 0.5, 0.0, 4.8)
+      e.sample(1000.5, 24.0, sensitivity, vertical, 0.015)
+      return e.outY
+    }
+    assertEquals(0.24f, steadyY(1.0, 1.0), 0.002f)
+    assertEquals(0.12f, steadyY(1.0, 0.5), 0.002f)
+    assertEquals(0.48f, steadyY(2.0, 1.0), 0.002f)
+    assertEquals(1f, steadyY(8.0, 1.0), 1e-6f) // never past the stick's range
+  }
+
+  @Test
+  fun clearForgetsTheFinger() {
+    val e = TouchLookEngine()
+    e.beginStroke(0.0)
+    e.addMove(8.0, 8.5, 4.8, 0.0)
+    e.clear()
+    assertFalse(e.sample(20.0, 24.0, 1.0, 1.0, 0.2))
+    assertEquals(0f, e.outX, 0f)
+  }
+
+  @Test
+  fun theCurveSkipsTheGamesDeadZone() {
+    fun shape(m: Double, deadZone: Double) = TouchLookEngine.shape(m, deadZone)
+    assertEquals(0.0, shape(0.0, 0.2), 0.0)
+    // the slowest motion that counts lands at the dead zone's edge: the game just starts to turn
+    assertEquals(0.2, shape(0.015, 0.2), 1e-12)
+    assertEquals(1.0, shape(1.0, 0.2), 1e-12)
+    assertEquals(1.0, shape(3.0, 0.2), 0.0)
+    // a dead zone as small as the ramp is no skip at all
+    assertEquals(0.4, shape(0.4, 0.0), 1e-12)
+    assertEquals(0.4, shape(0.4, 0.015), 1e-12)
+    var last = 0.0
+    var m = 0.0
+    while (m <= 1.3) {
+      val v = shape(m, 0.25)
+      assertTrue("not rising at $m", v >= last)
+      last = v
+      m += 0.0005
+    }
+  }
+}
