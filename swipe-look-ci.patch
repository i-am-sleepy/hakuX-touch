+  @Test
+  fun turboIsSetPerSource() {
+    val c = TouchLookConfig().withTurbo(1, true).withTurbo(4, true)
+    assertTrue(c.hasTurbo(1) && c.hasTurbo(4))
+    assertFalse(c.hasTurbo(0) || c.hasTurbo(2) || c.hasTurbo(3))
